<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Disallow user-installed CA certificates for API connections.
         Prevents MITM via corporate MDM or debug proxies from
         intercepting the API key and user prompts/screenshots. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.anthropic.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Default: allow system CAs only, no cleartext -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
