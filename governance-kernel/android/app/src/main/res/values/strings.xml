    <!-- Onboarding -->
    <string name="onboarding_title_1">Agent governance</string>
    <string name="onboarding_body_1">Oak &amp; Sparrow reviews every action an AI agent proposes on your behalf before it executes. Actions are scored, and risky ones are held for your review.</string>
    <string name="onboarding_title_2">Accessibility access</string>
    <string name="onboarding_body_2">To verify that agent actions actually completed as reported, we need accessibility service access. This lets us confirm outcomes without trusting the agent\'s self-reports.</string>
    <string name="onboarding_title_3">Notifications</string>
    <string name="onboarding_body_3">We need notification permission to show you when agent actions need your approval and to display the governance status.</string>
    <string name="onboarding_title_4">Digital assistant</string>
    <string name="onboarding_body_4">Set Oak &amp; Sparrow as your default digital assistant so you can launch it by long-pressing the home button.</string>
    <string name="onboarding_title_5">Display over apps</string>
    <string name="onboarding_body_5">Allow Oak to show a floating mic button on top of other apps so you can talk to your assistant from anywhere — while browsing, texting, or using any app.</string>
