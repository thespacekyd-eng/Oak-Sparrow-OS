<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        INTERNET: governance-kernel-gated. Only used when the user opts
        into cloud LLM inference (hybrid mode). All requests are PII-
        stripped by PiiSanitizer before leaving the device. The kernel
        audit log records every cloud egress. Users who decline cloud
        mode get fully on-device inference with no network egress — the
        permission is present but never exercised.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Voice input. Required by VoiceController for SpeechRecognizer.
        We use createOnDeviceSpeechRecognizer (API 31+) when available
        to keep recognition local. The absence of INTERNET permission
        means even the fallback recognizer path cannot leak audio
        upstream from this app's process.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Contact lookup for SMS/call actions (resolve name → phone number). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Required for AlarmClock.ACTION_SET_ALARM / ACTION_SET_TIMER intents. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!--
        Android 11+ package visibility filter. The agent's open_app
        dispatcher uses PackageManager.getLaunchIntentForPackage() which
        requires either QUERY_ALL_PACKAGES (privileged) or an explicit
        <queries> block. We declare common apps so app-mode users can
        say "open Instagram" / "pull up YouTube" and have the demo work.
        For the full ROM-installed governance kernel, QUERY_ALL_PACKAGES
        is granted via privapp-permissions and this block is redundant
        but harmless.
    -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.google.android.calendar" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.android.chrome" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.android.settings" />
        <package android:name="com.spotify.music" />
        <package android:name="com.twitter.android" />
        <package android:name="com.whatsapp" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.discord" />
        <package android:name="com.Slack" />
        <package android:name="com.google.android.apps.photos" />
        <package android:name="com.android.camera" />
        <package android:name="com.google.android.apps.nbu.files" />
        <package android:name="com.android.vending" />
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.google.android.calculator" />
        <package android:name="com.google.android.contacts" />
        <package android:name="com.google.android.dialer" />
        <package android:name="com.google.android.keep" />
        <package android:name="com.google.android.apps.docs" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!--
            Android 11+ package visibility for TextToSpeech engines.
            Without this, queryIntentServices(TTS_SERVICE) returns empty
            and we can't inspect/initialize the on-device TTS engine.
        -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".GovernanceApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".OnboardingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" android:exported="true" />

        <activity
            android:name=".AuthorizationActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
            Voice-first assistant entry point. Long-press home (or whatever
            invokes the system assist gesture) routes here once the user
            sets Oak & Sparrow as the default Digital assistant app:
                Settings → Apps → Default apps → Digital assistant app
            Translucent so the user's previous activity stays visible
            behind the immersive listening overlay.
        -->
        <activity
            android:name=".AssistantActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".GovernanceKernelService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="agent_governance" />
        </service>

        <!--
            VPN service for system-wide network governance. Routes ALL
            device traffic through the governance kernel for inspection,
            tracker blocking, and audit logging. Runs entirely on-device —
            no remote VPN server. User must approve via Android system dialog.
        -->
        <service
            android:name=".GovernanceVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!--
            VoiceInteractionService: registers Oak & Sparrow in the
            system's "Digital assistant app" picker. Samsung One UI
            requires this — a bare ACTION_ASSIST activity isn't enough.
            The session trampolines to AssistantActivity.
        -->
        <service
            android:name=".voice.OakVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".voice.OakVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!--
            Floating mic bubble that stays on top of all apps.
            Tapping it launches AssistantActivity for voice chat.
        -->
        <service
            android:name=".FloatingOakService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_assistant" />
        </service>

    </application>
</manifest>
