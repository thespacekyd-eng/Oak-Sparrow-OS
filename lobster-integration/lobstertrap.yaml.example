# Lobster Trap policy pack — generated by CampaignDetector
# Apply with: lobstertrap policy load lobstertrap.yaml
#
# Rule design: Lobster Trap enforces per-prompt rules (the floor).
# CampaignDetector enforces campaign-level rules (the ceiling).
# Together they provide defense-in-depth at both the micro and macro level.
#
# Rule evaluation is first-match-wins.  Order: hardest blocks first.

version: "1"
policy_name: "oak-sparrow-governance"
description: >
  Policy pack for the Oak-Sparrow governance kernel integration.
  Pairs with the Xenarch-derived CampaignDetector for trajectory-level
  anomaly detection on top of per-prompt DPI enforcement.

rules:

  # ── Hard blocks — always DENY ─────────────────────────────────────────────

  - id: block-prompt-injection
    description: Deny known prompt injection patterns
    match:
      injection_detected: true
      risk_score: ">= 0.6"
    action: DENY
    log: true
    metadata:
      campaign_signal: "injection_attempt"
      governance_outcome: "VETO"

  - id: block-credential-exfiltration
    description: Deny attempts to exfiltrate detected credentials
    match:
      credentials_detected: true
      exfiltration_patterns:
        contains_any: ["credential_exfiltration", "outbound_request"]
    action: DENY
    log: true
    metadata:
      campaign_signal: "data_exfil"
      governance_outcome: "VETO"

  - id: block-remote-code-execution
    description: Deny shell commands that download and execute remote content
    match:
      risky_commands:
        contains_any: ["wget", "curl", "nc", "netcat"]
      detected_intent: "command_exec"
    action: DENY
    log: true

  # ── Human-review gate — HUMAN_REVIEW ─────────────────────────────────────

  - id: review-credential-access
    description: Escalate credential access for human review
    match:
      detected_intent:
        in: ["credential_access", "privilege_escalation"]
    action: HUMAN_REVIEW
    log: true
    metadata:
      campaign_signal: "credential_probe"
      governance_outcome: "HOLD"

  - id: review-intent-drift
    description: >
      Flag when detected intent differs from declared intent toward
      sensitive categories — the declared-vs-detected mismatch signal.
    match:
      declared_intent:
        in: ["file_read", "data_query"]
      detected_intent:
        in: ["credential_access", "data_exfil", "injection_attempt"]
    action: HUMAN_REVIEW
    log: true
    metadata:
      campaign_signal: "intent_drift"

  - id: review-high-risk
    description: Human review for any prompt with risk score >= 0.65
    match:
      risk_score: ">= 0.65"
    action: HUMAN_REVIEW
    log: true

  # ── Rate limiting — RATE_LIMIT ────────────────────────────────────────────

  - id: ratelimit-data-access
    description: Rate-limit bulk data queries (calibration-poisoning defense)
    match:
      detected_intent: "data_access"
    action: RATE_LIMIT
    rate_limit:
      requests: 10
      window_seconds: 60
    log: true
    metadata:
      governance_outcome: "HOLD"

  # ── Logging — LOG ─────────────────────────────────────────────────────────

  - id: log-pii
    description: Log all prompts that contain PII
    match:
      pii_detected: true
    action: LOG

  - id: log-moderate-risk
    description: Log all prompts with elevated but not alarming risk
    match:
      risk_score: ">= 0.3"
    action: LOG

  # ── Default — ALLOW ───────────────────────────────────────────────────────

  - id: allow-benign
    description: Allow and log all benign prompts
    match: {}
    action: ALLOW
    log: false
